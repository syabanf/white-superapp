# Shared by every service (docker-compose sets these per container)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/white_analytics
NATS_URL=nats://localhost:4222
AUTH_SECRET=change-me
# Production: identity holds the private key, other services the public key.
# openssl rand -base64 32 -> JWT_PRIVATE_KEY (seed); derive the public key with `white-identity keys`.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
LOG_LEVEL=info
LOG_FORMAT=json

# Service addresses (gRPC)
IDENTITY_ADDR=localhost:9001
INTEGRATIONS_ADDR=localhost:9002
ANALYTICS_ADDR=localhost:9003
PUBLISHING_ADDR=localhost:9004
SEOSUITE_ADDR=localhost:9005
REPORTS_ADDR=localhost:9006
FINANCE_ADDR=localhost:9007
HR_ADDR=localhost:9008
RECRUITMENT_ADDR=localhost:9009
SALES_ADDR=localhost:9010
PERFORMANCE_ADDR=localhost:9012
CONTENT_ADDR=localhost:9011

# Next.js -> gateway session bridge (identity checks it; set the same value in white-analytics/.env)
INTERNAL_API_SECRET=

# gateway
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# integrations only: secrets at rest (same value as the Next.js app so old rows decrypt)
ENCRYPTION_KEY=
# env fallbacks when the setup wizard has not stored a value
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_USD_IDR=16000
APIFY_TOKEN=
APIFY_ACTORS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
PAGESPEED_API_KEY=

# publishing: media storage (local disk; swap the storage adapter for S3/R2)
UPLOAD_DIR=./.uploads

# ERP and content: per-service upload dirs (receipts, payslips, attachments, decks)
FINANCE_UPLOAD_DIR=./.uploads/finance
HR_UPLOAD_DIR=./.uploads/hr
RECRUITMENT_UPLOAD_DIR=./.uploads/recruitment
SALES_UPLOAD_DIR=./.uploads/sales
PERFORMANCE_UPLOAD_DIR=./.uploads/performance
CONTENT_UPLOAD_DIR=./.uploads/content
# hr: company name on payslips; recruitment: on offer letters, plus who hears about applications (comma-separated user ids)
HR_COMPANY_NAME=WHITE
RECRUITMENT_COMPANY_NAME=WHITE
RECRUITMENT_NOTIFY_USER_IDS=
# sales: optional ADMIN token for client creation from background work; WhatsApp stays off unless both WA vars are set
SALES_SERVICE_TOKEN=
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
