# Salin ke .env di server (sebelah docker-compose.prod.yml), lalu isi.
# File ini dibaca semua service. Jangan pernah commit .env yang sudah terisi.

# Domain publik gateway. Arahkan A record-nya ke IP server ini.
API_DOMAIN=api.example.com
# Image dari GitHub Container Registry (dibangun workflow "Backend deploy").
IMAGE_PREFIX=ghcr.io/syabanf/mixist

# Database yang SAMA dengan DATABASE_URL aplikasi Next.js di Vercel.
# Identity membaca user dari tabel public."User", jadi database terpisah membuat login ERP gagal.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# openssl rand -base64 32. Kunci JWT diturunkan dari sini bila JWT_PRIVATE_KEY kosong.
AUTH_SECRET=
# Nilainya harus sama persis dengan INTERNAL_API_SECRET di Vercel.
INTERNAL_API_SECRET=
# Nilainya harus sama dengan ENCRYPTION_KEY di Vercel, supaya token OAuth lama tetap terbaca.
ENCRYPTION_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Alamat aplikasi Next.js (tautan di email, PDF, portal publik) dan origin yang boleh memanggil gateway.
APP_BASE_URL=https://agency-system.reddie.id
CORS_ORIGINS=https://agency-system.reddie.id
LOG_LEVEL=info

# Penyedia data (opsional; setup wizard juga bisa menyimpan nilainya)
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_USD_IDR=16000
APIFY_TOKEN=
APIFY_ACTORS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
PAGESPEED_API_KEY=

# ERP
HR_COMPANY_NAME=Mixist
RECRUITMENT_COMPANY_NAME=Mixist
RECRUITMENT_NOTIFY_USER_IDS=
SALES_SERVICE_TOKEN=
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
